{
  "name": "pi-edit-first",
  "version": "0.1.3",
  "description": "Pi extension that cuts output tokens: blocks whole-file `write` rewrites and hand-written project manifests, steering the agent to targeted `edit` calls and scaffolders. Zero prompt tokens.",
  "keywords": ["pi-package", "pi-extension", "tokens", "edit", "guard"],
  "license": "MIT",
  "author": "sorinirimies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorinirimies/pi-edit-first.git"
  },
  "homepage": "https://github.com/sorinirimies/pi-edit-first#readme",
  "files": ["extensions", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./extensions/edit-first.ts"]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "nu scripts/ci/quality_gate.nu"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
